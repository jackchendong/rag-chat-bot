DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=chat_app
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=chat


# Agent 总开关；false 时仅普通对话，仍保存任务审计记录
AGENT_ENABLED=true
# 每次回答最多模型轮数，包含最终回答；最后一轮不开放工具，范围 1–20
AGENT_MAX_ROUNDS=6
# 每次回答最多工具调用次数（含 load_skill），范围 1–50
AGENT_MAX_TOOL_CALLS=12
# 整个 agent loop 总耗时上限秒数，范围 (0,240]，小于会话占用过期时间
AGENT_TIMEOUT_SECONDS=120
# 单次工具执行上限秒数，范围 (0,60]；超时会取消请求/终止子进程
AGENT_TOOL_TIMEOUT_SECONDS=20
# stop 持久化标记轮询间隔秒数，范围 0.05–2
AGENT_STOP_POLL_SECONDS=0.25
# 模型上下文字符预算（含系统指令、工具定义、历史与结果），范围 20000–200000
AGENT_MAX_CONTEXT_CHARS=60000
# 单个工具结果字符预算；Shell 同时以此值限制 stdout+stderr 字节，范围 1000–20000
AGENT_MAX_TOOL_OUTPUT_CHARS=12000
# Skills 目录；相对路径以 app 为基准，管理员维护其中的 <name>/SKILL.md
AGENT_SKILLS_DIR=./skills
# 通用搜索与网页读取开关；天气工具独立控制
AGENT_WEB_ENABLED=true
# auto：有 Tavily 密钥时使用 Tavily，否则使用免密钥公开搜索；public：固定公开搜索；tavily：必须配置密钥
AGENT_WEB_PROVIDER=auto
# 可选 Tavily 密钥，仅在后端使用；auto/public 模式无需填写也可联网
TAVILY_API_KEY=
# 受限 Shell 工具开关；不是完整终端，也不是操作系统沙箱
AGENT_SHELL_ENABLED=true
# 固定工作目录；不支持模型指定 cwd；相对路径以 app 为基准
AGENT_SHELL_WORKSPACE=./workspace
# 白名单仅支持下列只读/文本程序；参数还会逐个校验，不支持 shell/脚本/管道
AGENT_SHELL_ALLOWLIST=pwd,ls,date,echo,uname,whoami

# 免密钥天气工具（Open-Meteo 非商业公共 API），独立于 Tavily；需服务器能访问公网
AGENT_WEATHER_ENABLED=true
